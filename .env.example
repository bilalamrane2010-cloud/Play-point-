# ===== Play-point bot — environment variables =====
# Copy this file to .env (locally) or paste the values into
# Railway → your service → Variables.

# --- Required ---
# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:AA...

# Comma-separated Telegram user IDs allowed to control the bot.
# Leave empty ONLY while testing — anyone can control the bot otherwise.
ALLOWED_USER_IDS=123456789

# --- AI report generation (Groq) ---
OPENAI_API_KEY=gsk_...
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=openai/gpt-oss-120b

# --- Storage ---
BOT_DATA_DIR=bot_data
TZ=Africa/Algiers

# --- Email transport ---
# auto | smtp | brevo | resend | apps_script
# Railway blocks SMTP ports 25/465/587, so use apps_script (free, Gmail relay)
# or brevo/resend on Railway.
EMAIL_TRANSPORT=auto

# Option A — Google Apps Script Gmail relay (recommended on Railway)
APPS_SCRIPT_URL=https://script.google.com/macros/s/XXXX/exec
APPS_SCRIPT_SECRET=change-me

# Option B — Brevo (300 emails/day free)
BREVO_API_KEY=

# Option C — Resend
RESEND_API_KEY=

# --- Anti-spam ---
# Minimum seconds between two submissions (default 21600 = 6 hours)
MIN_SEND_INTERVAL_SECONDS=21600
