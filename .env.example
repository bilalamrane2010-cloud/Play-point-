# ===== Play-point bot — optional overrides =====
# The bot ALREADY contains working defaults, so this file is OPTIONAL.
# Create these variables only if you want to change a value.

# Telegram bot token (default is built into main.py)
# TELEGRAM_BOT_TOKEN=123456789:AA...

# Comma-separated Telegram user IDs allowed to control the bot
# (default: 7373420615)
# ALLOWED_USER_IDS=7373420615

# AI report generation (Groq) — defaults are built into core.py
# OPENAI_API_KEY=gsk_...
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=openai/gpt-oss-120b

# Storage
# BOT_DATA_DIR=bot_data
# TZ=Africa/Algiers

# Email transport: auto | smtp | brevo | resend | apps_script
# "auto" already uses the Google web form (no App Password needed).
# EMAIL_TRANSPORT=auto

# Optional Gmail relay over HTTPS (needed only if you want SMTP on Railway)
# APPS_SCRIPT_URL=https://script.google.com/macros/s/XXXX/exec
# APPS_SCRIPT_SECRET=change-me
# BREVO_API_KEY=
# RESEND_API_KEY=

# Minimum seconds between two submissions (default 21600 = 6 hours)
# MIN_SEND_INTERVAL_SECONDS=21600
